# LAB DECOY — non-functional, fake AWS credentials to demonstrate gitleaks secret
# scanning (this is the leaked key from the SPLINTER VIPER supply-chain scenario, KP-0060).
# gitleaks' default AWS rules flag these; they are allowlisted in ../../.gitleaks.toml so CI
# stays green while still catching any NEW, un-allowlisted secret. NOT a real key.
AWS_ACCESS_KEY_ID=AKIA-LAB-DECOY-NOT-A-REAL-KEY
AWS_SECRET_ACCESS_KEY=LAB-DECOY-SECRET-NOT-REAL-000000000000
